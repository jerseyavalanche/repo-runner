# Copy to ~/.config/codex-telegram-bridge/.env and chmod 600.
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_ALLOWED_USER_ID=123456789
TELEGRAM_ALLOWED_CHAT_ID=123456789
CODEX_WORKSPACE=/root/repo-runner
CODEX_BINARY=/usr/bin/codex
CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_SECONDS=1800
TELEGRAM_POLL_TIMEOUT_SECONDS=30
BRIDGE_STATE_FILE=/root/.local/state/codex-telegram/session.json
BRIDGE_LOG_FILE=/root/.local/state/codex-telegram/bridge.log
